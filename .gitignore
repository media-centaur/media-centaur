# Local MCP server config (machine-specific)
.mcp.json

# 4K marketing screenshots are too big to live in the main repo. They go
# to media-centaur/media-centaur-assets and are served via jsDelivr.
# scripts/regenerate-screenshots writes the 4K outputs straight into the
# sibling assets repo; this rule keeps the legacy local path from
# accidentally re-entering history.
/docs-site/assets/screenshots/4k/

# Release overlay synthesized at build time from defaults/media-centaur.toml.
# Source of truth lives in defaults/; the overlay copy is regenerated by
# scripts/preflight and the release CI workflow.
/rel/platforms/shared/share/defaults/media-centaur.toml

# Build info written by the release CI workflow (version, built_at, git_sha).
# Absent in dev/test — the app falls back to a "dev build" label.
/priv/build_info.json

# Showcase demo data — populated by `mix seed.showcase` with the shipped
# override TOML. Self-contained inside the repo so `rm -rf priv/showcase/`
# resets the demo cleanly.
/priv/showcase/media/
/priv/showcase/images/
/priv/showcase/image-derivatives/
/priv/showcase/*.db
/priv/showcase/*.db-*

# Profile-run artifacts — DB, fake media dir, and per-run markdown / JSON
# reports. Wiped on every scripts/profile invocation (unless --keep-db).
# Per-run reports are machine-specific noise; commit a curated snapshot to
# priv/profiling/baseline-<scale>.{md,json} instead — those baseline files
# are explicitly tracked. See ADR-041 and the planning notes at
# /home/shawn/.claude/plans/can-we-build-a-federated-rocket.md.
/priv/profile/
/priv/profiling/runs/*
!/priv/profiling/runs/.gitkeep

# Design mockups — produced ad-hoc during brainstorming sessions, not
# part of the production app. Keep out of the tree.
/mockups/

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
media_centaur-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Local env varibales
/.envrc

# Serena IDE plugin
/.serena/

# Playwright E2E tests
/test/e2e/node_modules/
/test/e2e/test-results/
/test-results/
/playwright-report/

# sqlite stuff
/media_centaur_dev*
/media_centaur_test*
/priv/repo/*.db
/priv/repo/*.db-shm
/priv/repo/*.db-wal

# Runtime data (downloaded images, etc.)
/data/
.superpowers/

# Local AI tooling state (machine-specific)
/.claude/settings.json
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Internal project backlog
/todo/

# Dev friend identity for Social development — `just social` creates it.
/priv/dev-social/
