[Unit]
Description=Media Centaur Backend (Dev)
# Do NOT add graphical-session.target here. This unit is WantedBy=default.target;
# pulling the session target into the default.target transaction creates an
# ordering cycle that systemd breaks by deleting session jobs, which loops the
# GNOME login on Ubuntu. mpv's display env is resolved at the app layer by
# MediaCentaur.Platform.DisplayEnv instead.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Set this to your media-centaur backend source directory, e.g.:
#   WorkingDirectory=%h/src/media-centaur/media-centaur
WorkingDirectory=/path/to/media-centaur/media-centaur
# Pull WAYLAND_DISPLAY / DISPLAY into the systemd-user manager so mpv can open
# a window. Leading `-` makes this best-effort; the app's DisplayEnv resolver
# falls back to socket discovery if the import didn't fire.
ExecStartPre=-/usr/bin/systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE
ExecStart=/usr/bin/mise exec -- mix phx.server
Environment=MIX_ENV=dev
Environment=ELIXIR_ERL_OPTIONS="-name media_centaur_dev@127.0.0.1"
# Point the dev instance at its own TOML for port, database, and socket
# directories. Since the dev-only consolidation this is the sole instance
# on the machine and binds 2160 directly (no installed release to race).
Environment=MEDIA_CENTAUR_CONFIG_OVERRIDE=%h/.config/media-centaur/media-centaur-dev.toml
# always, not on-failure: an external SIGTERM (e.g. a stray pkill) exits the BEAM
# cleanly and must not leave the daemon dead. An explicit systemctl stop still stops.
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=default.target
