# shellcheck shell=bash disable=SC2034
# Shared helpers for the install scenarios. Sourced, not executed.
#
# Every scenario runs as the invoking user against the real installed
# paths, so it runs the same on a GitHub runner, in a VM and on a user's
# machine. The service manager differs by platform; <platform>/platform
# answers for it (launchctl on macOS, systemctl --user on Linux) with:
#
#   PLATFORM_TAG          release tarball platform, e.g. darwin-arm64
#   SERVICE_FILE          the plist or unit file the installer writes
#   SUMMARY_RUNNING       the installer summary's line for a started service
#   service_manager_ok    the user's service manager is reachable
#   service_autostarts    the service is set to start at login
#   service_running       the service manager reports the app running
#   service_stop          stop the service without removing it
#   assert_service_removed   after uninstall: gone and not autostarting
#
# Bash 3.2 compatible: that is the bash macOS ships.

case "$(uname -s)" in
    Darwin) PLATFORM=macos ;;
    Linux)  PLATFORM=linux ;;
    *) printf 'FAIL: no scenarios for %s\n' "$(uname -s)" >&2; exit 1 ;;
esac

SCENARIOS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCENARIOS_DIR/../.." && pwd)"
INSTALL_ROOT="$HOME/.local/lib/media-centaur"
CONFIG_DIR="$HOME/.config/media-centaur"
DATA_DIR="$HOME/.local/share/media-centaur"
APP_URL="http://localhost:2160/"
# Scenario output a later scenario reads, and collect-evidence keeps.
SCENARIO_LOG_DIR="${MC_SCENARIO_LOG_DIR:-$HOME/install-repro-logs}"

step() { printf '\n--- %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
pass() { printf 'PASS: %s\n' "$1"; }

# The tag under test, from MC_TAG (vX.Y.Z).
require_tag() {
    [ -n "${MC_TAG:-}" ] || fail "MC_TAG is not set (expected a release tag such as v1.60.3)"
}

# Any HTTP status counts: the first page redirects to setup.
app_answers() {
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$APP_URL" || true)
    [ -n "$code" ] && [ "$code" != "000" ]
}

app_down() { ! app_answers; }

wait_until() {
    description="$1"
    timeout="$2"
    shift 2
    elapsed=0
    until "$@"; do
        [ "$elapsed" -lt "$timeout" ] || fail "$description (waited ${timeout}s)"
        sleep 2
        elapsed=$((elapsed + 2))
    done
    pass "$description (${elapsed}s)"
}

installed_version() { "$INSTALL_ROOT/current/bin/media_centaur" version 2>/dev/null | awk '{print $NF}'; }

assert_version() {
    want="${1#v}"
    got=$(installed_version)
    [ "$got" = "$want" ] || fail "installed version is '$got', expected '$want'"
    pass "installed version is $want"
}

# The version the running app reports — not the one `current` points at,
# which a failed restart would leave out of step with it.
assert_running_version() {
    want="${1#v}"
    got=$("$INSTALL_ROOT/current/bin/media_centaur" rpc 'IO.puts(MediaCentaur.Version.current_version())' 2>/dev/null || true)
    [ "$got" = "$want" ] || fail "the running app reports '$got', expected '$want'"
    pass "the running app reports $want"
}

# The service is set to start at login, is running, and the app answers.
assert_serving() {
    service_autostarts || fail "the service is not set to start at login"
    pass "the service starts at login"
    wait_until "the service is running" 30 service_running
    wait_until "app answers at $APP_URL" 120 app_answers
}

# The run's source, from MC_SOURCE: `released` (a published release) or
# `branch` (a release built from the branch, at MC_BRANCH_TARBALL, whose
# version MC_TAG names).
source_kind() { printf '%s' "${MC_SOURCE:-released}"; }

# Prints the path of the release tarball for a tag: the branch build when
# the tag is the one under test in a branch run, otherwise the published
# tarball, downloaded into a fresh directory.
release_tarball() {
    tag="$1"
    if [ "$(source_kind)" = branch ] && [ "$tag" = "${MC_TAG:-}" ]; then
        [ -f "${MC_BRANCH_TARBALL:-}" ] || fail "MC_BRANCH_TARBALL does not name the branch build"
        printf '%s' "$MC_BRANCH_TARBALL"
        return
    fi
    name="media-centaur-${tag#v}-${PLATFORM_TAG}.tar.gz"
    dir=$(mktemp -d)
    curl -fsSL -o "$dir/$name" "https://github.com/media-centaur/media-centaur/releases/download/$tag/$name" ||
        fail "could not download $name"
    printf '%s' "$dir/$name"
}

# Installs a release tag. A published release goes through the public
# installer, as `curl … | sh` would. A branch build runs its bundled
# installer directly — the step the public installer hands off to after
# its download and checksum check.
install_release() {
    tag="$1"
    case "$(source_kind)" in
        released) sh "$REPO_ROOT/installer/install.sh" --version "$tag" ;;
        branch)
            if [ "$tag" != "${MC_TAG:-}" ]; then
                sh "$REPO_ROOT/installer/install.sh" --version "$tag"
                return
            fi
            work=$(mktemp -d)
            tar -xzf "$(release_tarball "$tag")" -C "$work"
            printf '==> Installing the branch build %s\n' "$tag"
            "$work/bin/media-centaur-install"
            ;;
        *) fail "MC_SOURCE must be released or branch, not '$MC_SOURCE'" ;;
    esac
}

# shellcheck source=/dev/null
. "$SCENARIOS_DIR/$PLATFORM/platform"
