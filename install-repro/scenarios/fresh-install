#!/usr/bin/env bash
# Scenario: a fresh install without sudo, through the public installer,
# ends with the service set to start at login, running, and the app
# answering.
set -euo pipefail
. "$(dirname "$0")/lib"
require_tag

step "user service manager"
service_manager_ok || fail "this user's service manager is not reachable; autostart cannot be tested here"
pass "the user's service manager is reachable"

step "install $MC_TAG"
mkdir -p "$SCENARIO_LOG_DIR"
out="$SCENARIO_LOG_DIR/fresh-install.log"
install_release "$MC_TAG" | tee "$out"
grep -q "$SUMMARY_RUNNING" "$out" || fail "the installer summary does not report the service running"
pass "the summary reports the service running"

assert_serving
assert_version "$MC_TAG"
[ -f "$CONFIG_DIR/secrets.env" ] || fail "secrets.env was not generated"
pass "secrets.env generated"
