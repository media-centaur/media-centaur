#!/usr/bin/env bash
# Scenario: the fresh install logged no error. Reads the installer output
# fresh-install saved. A separate scenario so a logged error does not stop
# the install scenarios after fresh-install from running.
set -euo pipefail
. "$(dirname "$0")/lib"

log="$SCENARIO_LOG_DIR/fresh-install.log"
[ -f "$log" ] || fail "no fresh-install output at $log; run fresh-install first"
if grep -n '\[error\]' "$log"; then
    fail "the fresh install logged the errors above"
fi
pass "the fresh install logged no error"
