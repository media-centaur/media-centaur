#!/usr/bin/env bash
# Copies what a failed scenario needs into one directory: the app logs,
# every update handoff log, launchd state and the installed tree's shape.
# Never copies secrets.env.
set -uo pipefail
. "$(dirname "$0")/lib"

out="${1:?usage: collect-evidence <dir>}"
mkdir -p "$out"
cp -R "$HOME/Library/Logs/Media Centaur" "$out/app-logs" 2>/dev/null
mkdir -p "$out/handoff"
for log in "$HOME"/.cache/media-centaur/upgrade-staging/*/handoff.log; do
    [ -f "$log" ] && cp "$log" "$out/handoff/$(basename "$(dirname "$log")").log"
done
launchctl print "$(ctl_target)" > "$out/launchctl-agent.txt" 2>&1
launchctl print-disabled "$(ctl_domain)" > "$out/launchctl-disabled.txt" 2>&1
ls -laR "$INSTALL_ROOT" > "$out/install-root.txt" 2>&1
ls -la "$CONFIG_DIR" > "$out/config-dir.txt" 2>&1
cp "$PLIST" "$out/" 2>/dev/null
cp -R "$SCENARIO_LOG_DIR" "$out/scenario-logs" 2>/dev/null
true
