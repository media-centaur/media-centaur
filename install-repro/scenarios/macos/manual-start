#!/usr/bin/env bash
# Scenario: with the agent unloaded, `bin/media_centaur daemon` boots the
# app. The release reads SECRET_KEY_BASE from secrets.env itself; the app
# raises at boot without it. Ends by restoring autostart through
# `service install`.
set -euo pipefail
. "$(dirname "$0")/lib"

bin="$INSTALL_ROOT/current/bin"

step "unload the agent"
launchctl bootout "$(ctl_target)"
wait_until "the app stops answering" 60 app_down

step "start manually"
"$bin/media_centaur" daemon
wait_until "app answers at $APP_URL" 120 app_answers

step "stop"
"$bin/media_centaur" stop
wait_until "the app stops answering" 60 app_down

step "restore autostart"
"$bin/media-centaur-install" service install
assert_serving
