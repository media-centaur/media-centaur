<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for Media Centaur on macOS — Linux systemd-user analog.

  Installed by `bin/media-centaur-install` (macOS variant) to
  ~/Library/LaunchAgents/com.media-centaur.app.plist after %HOME%
  substitution (launchd does NOT expand $HOME or ~ inside paths,
  only inside EnvironmentVariables values).

  ProgramArguments points at a wrapper script (bin/media-centaur-launchd-start)
  that loads secrets.env from ~/.config/media-centaur/, mirroring the
  Linux unit's `EnvironmentFile=` behavior. The wrapper exec's the
  release binary in foreground so launchd directly supervises the BEAM PID.

  KeepAlive restarts only on crash / non-zero exit — not on clean stops,
  so `launchctl bootout` actually stops the agent. ThrottleInterval
  prevents tight restart loops if the BEAM repeatedly fails at boot.

  Log paths match Platform.LogSource.Files defaults; the Console drawer's
  "System" tab tails these files on macOS the way it tails journald on Linux.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.media-centaur.app</string>

  <key>ProgramArguments</key>
  <array>
    <string>%HOME%/.local/lib/media-centaur/current/bin/media-centaur-launchd-start</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>%HOME%/Library/Logs/Media Centaur/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>%HOME%/Library/Logs/Media Centaur/stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
