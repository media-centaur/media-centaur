#!/bin/sh
# media-centaur-install — macOS install / update / autostart manager.
#
# Mirrors the Linux installer's contract; the only differences are the
# autostart system (launchd vs systemd) and the release-tarball platform
# tag (darwin-arm64 vs linux-x86_64).
#
# Modes:
#
#   (default — install / upgrade)
#     ./bin/media-centaur-install [--no-service] [--no-start]
#       Installs THIS release atomically into ~/.local/lib/media-centaur/,
#       seeds config, runs migrations, flips the `current` symlink. On a
#       first install, also templates the LaunchAgent plist (%HOME%
#       substitution), drops it into ~/Library/LaunchAgents/, and
#       bootstraps + kickstarts it via launchctl. Skips autostart steps
#       gracefully when launchctl is unavailable (extremely unusual on
#       macOS — would mean a stripped-down environment).
#
#   --update [--force]
#     ~/.local/lib/media-centaur/current/bin/media-centaur-install --update
#       Resolves the latest release on GitHub, downloads it, and re-execs
#       its bundled installer in default mode. Exits early if already at
#       the latest tag, unless --force is passed.
#
#   service install | service remove
#     Manage the LaunchAgent after the fact — set up autostart on an
#     existing app-only install, or remove autostart while leaving the
#     app in place.
#
#   --uninstall
#       Removes the app, symlink, and LaunchAgent. Preserves config,
#       data, and cache. The final summary prints the rm commands to
#       wipe those explicitly if desired.
#
# Atomic-upgrade contract (identical to Linux):
#   - Each release lives at ~/.local/lib/media-centaur/releases/<version>/
#   - ~/.local/lib/media-centaur/current is a symlink to one of them
#   - Migrations run against the new release BEFORE the symlink flips
#   - On any failure before the flip, the existing install keeps serving
#
# Designed for: macOS 12+ on Apple Silicon (arm64). XDG paths
# (~/.config, ~/.local/share, ~/.cache) per the deliberate non-seam
# decision — overridable via MEDIA_CENTAUR_*_DIR env vars.

set -eu

GITHUB_REPO="media-centaur/media-centaur"
INSTALL_ROOT="${MEDIA_CENTAUR_INSTALL_ROOT:-$HOME/.local/lib/media-centaur}"
CONFIG_DIR="${MEDIA_CENTAUR_CONFIG_DIR:-$HOME/.config/media-centaur}"
DATA_DIR="${MEDIA_CENTAUR_DATA_DIR:-$HOME/.local/share/media-centaur}"
CACHE_DIR="${MEDIA_CENTAUR_CACHE_DIR:-$HOME/.cache/media-centaur}"
LAUNCH_AGENT_DIR="${LAUNCH_AGENT_DIR:-$HOME/Library/LaunchAgents}"
LOG_DIR="${MEDIA_CENTAUR_LOG_DIR:-$HOME/Library/Logs/Media Centaur}"
LABEL="com.media-centaur.app"
PLIST_NAME="${LABEL}.plist"
PLATFORM_TAG="darwin-arm64"

banner() { printf '==> %s\n' "$1"; }
die()    { printf 'Error: %s\n' "$1" >&2; exit 1; }

# Resolve a SHA-256 verifier — macOS has `shasum -a 256` in the base
# install but not `sha256sum`. Honor either if both happen to be present
# (e.g., user has GNU coreutils via homebrew).
sha256_check() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -c -
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 -c -
    else
        die "Neither sha256sum nor shasum available; cannot verify checksum"
    fi
}

# Detect a working launchd user domain. launchctl is universally present
# on macOS, but in some constrained environments (CI containers, ssh
# without a GUI session bound to the user) the gui/$UID domain may not
# resolve. The probe is `launchctl print gui/$UID` — non-zero exit means
# we shouldn't attempt LaunchAgent control.
has_launchd_user() {
    [ "${MEDIA_CENTAUR_FAKE_NO_LAUNCHD:-0}" = "1" ] && return 1
    command -v launchctl >/dev/null 2>&1 || return 1
    launchctl print "gui/$(id -u)" >/dev/null 2>&1
}

# Locate the release root from this script's path. The script lives at
# <release_root>/bin/media-centaur-install. Resolve symlinks so the
# `current/bin/media-centaur-install --update` re-exec path still works.
script_path=$(readlink -f "$0" 2>/dev/null || realpath "$0")
release_root=$(cd "$(dirname "$script_path")/.." && pwd)

# Read the release version from the bundled mix release metadata.
# `bin/media_centaur version` prints "media_centaur 0.3.0" (or similar).
detect_version() {
    "$release_root/bin/media_centaur" version 2>/dev/null | awk '{print $NF}'
}

# Resolve the port the installed app will listen on. Same conventions as
# Linux: 1080 dev (never), 2160 production default, 4003 showcase.
detect_port() {
    toml="$CONFIG_DIR/media-centaur.toml"
    if [ -f "$toml" ]; then
        port=$(grep -E '^[[:space:]]*port[[:space:]]*=[[:space:]]*[0-9]+' "$toml" 2>/dev/null \
               | head -1 \
               | sed -E 's/.*=[[:space:]]*([0-9]+).*/\1/')
        if [ -n "${port:-}" ]; then
            printf '%s' "$port"
            return
        fi
    fi
    printf '%s' "2160"
}

# Validate a tag string against the canonical release shape. Same regex
# as Linux — single gate against tag-injection attacks before any tag
# value reaches URL construction or filesystem paths.
validate_tag() {
    printf '%s' "$1" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?$'
}

# Render the LaunchAgent plist by substituting %HOME% with the absolute
# path of the user's home. launchd does NOT expand $HOME or ~ inside
# StandardOutPath / ProgramArguments / etc. — only inside
# EnvironmentVariables values.
render_plist() {
    src="$1"
    dst="$2"
    [ -f "$src" ] || die "Bundled plist missing at $src"
    sed -e "s|%HOME%|$HOME|g" "$src" > "$dst"
}

# launchctl wrappers — all addressed in the gui/$UID domain. Helpers
# return non-zero on launchctl failure so callers can ignore-or-die.
ctl_target() { printf '%s' "gui/$(id -u)/$LABEL"; }
ctl_domain() { printf '%s' "gui/$(id -u)"; }

launchd_bootstrap() {
    plist="$1"
    launchctl bootstrap "$(ctl_domain)" "$plist"
}

launchd_bootout() {
    # Two-step: bootout unloads, then disable persists across logouts so
    # KeepAlive doesn't reload on next session.
    launchctl bootout "$(ctl_domain)" "$LABEL" 2>/dev/null || true
    launchctl disable "$(ctl_target)" 2>/dev/null || true
}

launchd_kickstart() {
    # -k = SIGTERM-then-restart. Use on upgrades to pick up the new
    # binary the symlink now points at.
    launchctl kickstart -k "$(ctl_target)"
}

launchd_enable_start() {
    launchctl enable "$(ctl_target)" 2>/dev/null || true
    launchctl kickstart "$(ctl_target)"
}

launchd_is_loaded() {
    launchctl print "$(ctl_target)" >/dev/null 2>&1
}

# ---- argument parsing ------------------------------------------------------

mode=install
no_service=0
no_start=0
force_update=0

if [ "${1:-}" = "service" ]; then
    case "${2:-}" in
        install) mode=service_install ;;
        remove)  mode=service_remove ;;
        *)       die "Usage: $0 service {install|remove}" ;;
    esac
    shift 2
fi

for arg in "$@"; do
    case "$arg" in
        --update)     mode=update ;;
        --uninstall)  mode=uninstall ;;
        --no-service) no_service=1 ;;
        --no-start)   no_start=1 ;;
        --force)      force_update=1 ;;
        --help|-h)
            sed -n '2,/^$/p' "$script_path" | sed 's/^# //;s/^#$//'
            exit 0
            ;;
        *) die "Unknown flag: $arg" ;;
    esac
done

# ---- summary helpers -------------------------------------------------------

summary_paths_preserved() {
    printf '  config  %s       rm -rf %s\n' "$CONFIG_DIR" "$CONFIG_DIR"
    printf '  data    %s/  rm -rf %s\n' "$DATA_DIR" "$DATA_DIR"
    printf '  cache   %s/         rm -rf %s\n' "$CACHE_DIR" "$CACHE_DIR"
    printf '  logs    %s/  rm -rf "%s"\n' "$LOG_DIR" "$LOG_DIR"
}

summary_uninstall_hint() {
    printf '\nTo uninstall:\n'
    printf '  %s/current/bin/media-centaur-install --uninstall\n' "$INSTALL_ROOT"
    printf '  # Removes app + symlink + LaunchAgent. Preserves:\n'
    printf '  #   config  %s        (rm -rf to delete)\n' "$CONFIG_DIR"
    printf '  #   data    %s/   (rm -rf to delete)\n' "$DATA_DIR"
    printf '  #   cache   %s/         (rm -rf to delete)\n' "$CACHE_DIR"
    printf '  #   logs    %s/  (rm -rf to delete)\n' "$LOG_DIR"
}

summary_manual_start_hint() {
    printf '\nAutostart not configured. Start the app with one of:\n'
    printf '  %s/current/bin/media_centaur start        # foreground\n' "$INSTALL_ROOT"
    printf '  %s/current/bin/media_centaur daemon       # background\n' "$INSTALL_ROOT"
    printf '  %s/current/bin/media_centaur start_iex    # foreground with IEx\n' "$INSTALL_ROOT"
    printf '\nTo set up autostart later:\n'
    printf '  %s/current/bin/media-centaur-install service install\n' "$INSTALL_ROOT"
}

# ---- update: download latest, then re-exec from new tree ------------------

if [ "$mode" = update ]; then
    command -v curl >/dev/null 2>&1 || die "curl is required for --update"
    command -v tar  >/dev/null 2>&1 || die "tar is required for --update"

    banner "Resolving latest release"
    api_url="https://api.github.com/repos/$GITHUB_REPO/releases/latest"
    tag=$(curl -fsSL "$api_url" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n1)
    [ -n "$tag" ] || die "Could not resolve latest release tag"
    validate_tag "$tag" || die "Rejected malformed tag: $tag"

    current_version=$(detect_version || echo unknown)
    latest_version=${tag#v}
    if [ "$current_version" = "$latest_version" ]; then
        if [ "$force_update" = 1 ]; then
            banner "Re-applying $current_version (--force)"
        else
            banner "Already at latest version: $current_version (pass --force to reinstall)"
            exit 0
        fi
    else
        banner "Updating from $current_version to $latest_version"
    fi

    # URLs are built from the validated tag + version — never from any
    # URL field the API response supplied.
    tarball="media-centaur-${latest_version}-${PLATFORM_TAG}.tar.gz"
    base_url="https://github.com/$GITHUB_REPO/releases/download/$tag"

    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT

    banner "Downloading $tarball"
    curl -fsSL -o "$tmpdir/$tarball"   "$base_url/$tarball"
    curl -fsSL -o "$tmpdir/SHA256SUMS" "$base_url/SHA256SUMS"

    banner "Verifying checksum"
    (cd "$tmpdir" && grep " $tarball\$" SHA256SUMS | sha256_check) \
        || die "Checksum verification failed"

    banner "Extracting"
    mkdir -p "$tmpdir/extract"
    tar -xzf "$tmpdir/$tarball" -C "$tmpdir/extract"

    new_installer="$tmpdir/extract/bin/media-centaur-install"
    [ -x "$new_installer" ] || die "Update tarball does not contain bin/media-centaur-install"

    banner "Handing off to new installer"
    exec "$new_installer"
fi

# ---- uninstall ------------------------------------------------------------

if [ "$mode" = uninstall ]; then
    banner "Stopping LaunchAgent"
    launchd_bootout

    banner "Removing $INSTALL_ROOT"
    rm -rf "$INSTALL_ROOT"

    banner "Removing LaunchAgent plist"
    rm -f "$LAUNCH_AGENT_DIR/$PLIST_NAME"

    banner "Uninstall complete"
    printf '\nRemoved:\n'
    printf '  app            %s/\n' "$INSTALL_ROOT"
    printf '  symlink        (via the above)\n'
    printf '  LaunchAgent    %s/%s\n' "$LAUNCH_AGENT_DIR" "$PLIST_NAME"
    printf '\nPreserved (delete manually if you want a full wipe):\n'
    summary_paths_preserved
    exit 0
fi

# ---- service install / service remove -------------------------------------

if [ "$mode" = service_install ]; then
    current_link="$INSTALL_ROOT/current"
    [ -L "$current_link" ] || die "No app installed at $current_link — run a normal install first"

    has_launchd_user || die "launchd gui/$(id -u) domain not available — cannot install autostart"

    plist_src="$(readlink -f "$current_link" 2>/dev/null || realpath "$current_link")/share/launchd/$PLIST_NAME"
    plist_dst="$LAUNCH_AGENT_DIR/$PLIST_NAME"
    [ -f "$plist_src" ] || die "Bundled LaunchAgent plist missing at $plist_src"

    mkdir -p "$LAUNCH_AGENT_DIR"
    render_plist "$plist_src" "$plist_dst"

    # Bootout-then-bootstrap so a stale loaded plist (from a prior
    # install) is replaced cleanly.
    launchd_bootout
    launchd_bootstrap "$plist_dst"
    launchd_enable_start

    banner "Autostart installed"
    printf '\n  plist   %s\n' "$plist_dst"
    printf '  state   loaded + running\n'
    printf '\nTo remove autostart:\n'
    printf '  media-centaur-install service remove\n'
    exit 0
fi

if [ "$mode" = service_remove ]; then
    launchd_bootout
    rm -f "$LAUNCH_AGENT_DIR/$PLIST_NAME"

    banner "Autostart removed"
    printf '\nApp still installed at %s/current.\n' "$INSTALL_ROOT"
    printf 'Start manually: %s/current/bin/media_centaur start\n' "$INSTALL_ROOT"
    exit 0
fi

# ---- install / upgrade (default mode) -------------------------------------

version=$(detect_version) || die "Could not detect release version from $release_root/bin/media_centaur"
[ -n "$version" ] || die "Empty version string from bin/media_centaur"

target="$INSTALL_ROOT/releases/$version"
current_link="$INSTALL_ROOT/current"

first_install=0
if [ ! -L "$current_link" ]; then
    first_install=1
fi

want_service=1
if [ "$no_service" = 1 ]; then
    want_service=0
fi
if ! has_launchd_user; then
    want_service=0
fi

banner "Installing media-centaur $version"
banner "  release tree: $release_root"
banner "  install root: $INSTALL_ROOT"

# 1. Stage the new release version.
if [ -d "$target" ]; then
    banner "Replacing existing $target"
    rm -rf "$target"
fi
mkdir -p "$target"
cp -a "$release_root/." "$target/"

# 2. Seed config dir (idempotent — never overwrite user edits).
mkdir -p "$CONFIG_DIR"
seed_toml="$target/share/defaults/media-centaur.toml"
user_toml="$CONFIG_DIR/media-centaur.toml"
if [ -f "$seed_toml" ] && [ ! -f "$user_toml" ]; then
    banner "Seeding config: $user_toml"
    cp "$seed_toml" "$user_toml"
fi

# 3. Render + install LaunchAgent plist when autostart wanted + available.
#    The plist is templated (%HOME% → actual home) at install time because
#    launchd doesn't expand $HOME inside plist paths.
plist_src="$target/share/launchd/$PLIST_NAME"
plist_dst="$LAUNCH_AGENT_DIR/$PLIST_NAME"
if [ "$want_service" = 1 ]; then
    mkdir -p "$LAUNCH_AGENT_DIR"
    if [ -f "$plist_src" ]; then
        banner "Installing LaunchAgent: $plist_dst"
        render_plist "$plist_src" "$plist_dst"
    else
        die "Bundled LaunchAgent plist missing at $plist_src"
    fi
fi

# 4. Seed secrets.env on first install.
secrets_file="$CONFIG_DIR/secrets.env"
if [ ! -f "$secrets_file" ]; then
    banner "Generating $secrets_file"
    secret_key_base=$(head -c 48 /dev/urandom | base64 | tr -d '\n')
    umask 077
    cat > "$secrets_file" <<EOF
# Media Centaur runtime secrets — loaded by media-centaur-launchd-start
# (the LaunchAgent wrapper) and by the bundled installer when running
# migrations.
#
# SECRET_KEY_BASE is auto-generated on first install. Do not change it
# unless you know what you're doing — sessions and signed tokens are
# bound to this value.
SECRET_KEY_BASE=$secret_key_base

# Optional: TMDB API key for metadata enrichment.
# TMDB_API_KEY=

# Optional: root directory to watch for new media files.
# MEDIA_DIR=$HOME/Movies
EOF
fi

# 5. Ensure the log directory exists so launchd's StandardOutPath /
#    StandardErrorPath have a writeable target on first boot.
mkdir -p "$LOG_DIR"

# 6. Run migrations against the NEW release, before the symlink flip.
banner "Running schema migrations against $version"
# shellcheck source=/dev/null
set -a; . "$secrets_file"; set +a
"$target/bin/media_centaur" eval "MediaCentaur.Release.migrate()"

banner "Running data migrations against $version"
"$target/bin/media_centaur" eval "MediaCentaur.Release.migrate_data()"

# 7. Atomic symlink flip.
banner "Pointing current -> releases/$version"
ln -sfn "releases/$version" "$current_link.new"
mv -f "$current_link.new" "$current_link"

# 8. Autostart handling.
#    - First install + want_service + no --no-start → bootstrap + enable + kickstart.
#    - Upgrade: kickstart -k if loaded; bootstrap+enable+kickstart if plist installed but not loaded; else leave alone.
autostart_state="not configured"
if [ "$want_service" = 1 ]; then
    if [ "$first_install" = 1 ] && [ "$no_start" != 1 ]; then
        banner "Bootstrapping + starting $LABEL"
        # Clean reload defensively in case a stale plist exists.
        launchd_bootout
        launchd_bootstrap "$plist_dst"
        launchd_enable_start
        autostart_state="loaded + running"
    elif launchd_is_loaded; then
        banner "Restarting $LABEL (kickstart -k)"
        # Re-render+bootout+bootstrap to pick up plist changes between versions.
        launchd_bootout
        launchd_bootstrap "$plist_dst"
        launchd_enable_start
        autostart_state="loaded + running"
    elif [ -f "$plist_dst" ]; then
        banner "Bootstrapping $LABEL (plist installed but not loaded)"
        launchd_bootstrap "$plist_dst"
        launchd_enable_start
        autostart_state="loaded + running"
    else
        autostart_state="plist installed, not loaded"
    fi
fi

# 9. Summary.
banner "Install complete"
printf '\nInstalled:\n'
printf '  Media Centaur %s\n' "$version"
printf '    release   %s/releases/%s/\n' "$INSTALL_ROOT" "$version"
printf '    symlink   %s\n' "$current_link"
printf '  Config (idempotent — preserved across upgrades):\n'
printf '    %s\n' "$user_toml"
printf '    %s\n' "$secrets_file"
if [ "$want_service" = 1 ]; then
    printf '  Autostart:\n'
    printf '    plist     %s\n' "$plist_dst"
    printf '    state     %s\n' "$autostart_state"
fi
printf '  Data (created on first run):\n'
printf '    %s/\n' "$DATA_DIR"
printf '  Logs (launchd-managed):\n'
printf '    %s/\n' "$LOG_DIR"

if [ "$want_service" = 1 ] && [ "$autostart_state" = "loaded + running" ]; then
    printf '\nOpen http://localhost:%s to get started.\n' "$(detect_port)"
else
    summary_manual_start_hint
fi

summary_uninstall_hint
