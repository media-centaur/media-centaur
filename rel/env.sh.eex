#!/bin/sh

export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE=media_centaur

# Disable BEAM scheduler busy-waiting — critical for a desktop daemon that
# idles most of the time. Saves significant CPU when no work is queued.
export ERL_FLAGS="+sbwt none +sbwtdcpu none +sbwtdio none"

# Load the runtime secrets (SECRET_KEY_BASE, written by the installer) for
# every release command: start, eval, remote. This is the one place they
# are loaded, so a manual `bin/media_centaur start` gets them exactly as
# the systemd unit and the LaunchAgent do.
media_centaur_secrets="${MEDIA_CENTAUR_CONFIG_DIR:-$HOME/.config/media-centaur}/secrets.env"
if [ -f "$media_centaur_secrets" ]; then
    set -a
    # shellcheck source=/dev/null
    . "$media_centaur_secrets"
    set +a
fi
unset media_centaur_secrets
