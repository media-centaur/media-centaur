<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Context map</title>
<style>
  :root { --bg: #f7f7f5; --fg: #1a1a1a; --muted: #6b6b66; --line: #d9d9d4; --panel: #ffffff; --accent: #2a5db0; --r1: #b35c00; --r3: #a0203a; --r4: #3c6e2f; --kernel: #e9eef6; }
  @media (prefers-color-scheme: dark) { :root { --bg: #15161a; --fg: #e8e8e4; --muted: #9a9a94; --line: #2c2d33; --panel: #1d1e24; --accent: #7aa2e8; --r1: #e6a15c; --r3: #ef7f98; --r4: #8cc77a; --kernel: #1f2a3a; } }
  body { margin: 0; padding: 24px 16px; background: var(--bg); color: var(--fg); font: 14px/1.45 system-ui, sans-serif; }
  h1, h2, h3 { font-weight: 600; margin: 0 0 8px; } h1 { font-size: 22px; } h2 { font-size: 17px; margin-top: 32px; } h3 { font-size: 15px; }
  table { border-collapse: collapse; } th, td { border: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
  th { color: var(--muted); font-weight: 500; } td.diag { background: var(--line); color: var(--muted); } td.kernel { background: var(--kernel); }
  .matrix-wrap { overflow-x: auto; } .matrix th, .matrix td { padding: 2px 3px; } .matrix tr > th:first-child { white-space: nowrap; padding-right: 8px; }
  .matrix th.rot { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; vertical-align: bottom; padding: 6px 3px; } .matrix td { text-align: center; } .matrix .count { display: block; margin: 1px 0; }
  .count { display: inline-block; min-width: 1.4em; padding: 0 4px; border-radius: 3px; color: #fff; font-size: 12px; margin-right: 2px; }
  .R1 { background: var(--r1); } .R3 { background: var(--r3); } .R4 { background: var(--r4); }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 12px 16px; margin: 12px 0; }
  .panel.kernel { border-color: var(--accent); } .schema { margin: 8px 0 16px; } .mono { font-family: ui-monospace, monospace; font-size: 12.5px; }
  .muted { color: var(--muted); } .chip { display: inline-block; padding: 0 6px; border-radius: 3px; font-size: 12px; color: #fff; margin-left: 4px; }
  .concept { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 8px 12px; margin: 10px 0; }
  .concept-head { margin-bottom: 4px; } .concept-head .chip { margin-left: 0; }
  .consumer { border-top: 1px solid var(--line); padding: 6px 0 6px 12px; } .consumer.unverdicted { border-left: 3px solid var(--accent); padding-left: 9px; }
  .consumer .key { font-size: 11.5px; }
  .finding { margin: 4px 0 0 12px; } .site { font-size: 12px; }
  .excerpt { margin: 2px 0 0; padding: 4px 8px; background: var(--bg); border-radius: 3px; font: 12.5px/1.4 ui-monospace, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
  .filters { display: flex; gap: 12px; flex-wrap: wrap; margin: 8px 0 16px; } .filters label { display: flex; gap: 4px; align-items: center; }
  td.type { max-width: 16em; overflow-wrap: anywhere; }
  .matrix td[data-cell] { cursor: pointer; } .matrix td.active { outline: 2px solid var(--accent); outline-offset: -2px; }
  .chip.exported { background: var(--accent); }
  .count.kernel-count { background: transparent; color: var(--muted); border: 1px solid var(--muted); }
  .filters select { font: inherit; }
  .hidden { display: none; }
</style>
</head>
<body>
<h1>Context map</h1>
<p class="muted">Schemas by bounded context and every crossing of a boundary at the data level. R1 foreign field · R3 reinterpretation · R4 cross-context key. Shaded cells are shared-kernel reads; click a cell to list its findings. Spec: <span class="mono">docs/superpowers/specs/2026-09-30-context-map-design.md</span>.</p>

<h2>Context matrix</h2>
<p class="muted">Rows own the representation; columns interpret, key into, or write it. Context names drop the <span class="mono">MediaCentaur.</span> prefix.</p>
<div class="matrix-wrap"><table class="matrix">
<tr><th>owner ↓ / consumer →</th><%= for consumer <- @consumers do %><th class="rot" title="<%= h(consumer) %>"><%= label(consumer) %></th><% end %></tr>
<%= for context <- @contexts do %>
<tr><th title="<%= h(context.name) %>"><%= label(context.name) %><%= if context.kernel do %> <span class="muted">(kernel)</span><% end %></th>
<%= for consumer <- @consumers do %>
<% counts = Map.get(@matrix, {context.name, consumer}, %{}) %>
<% kernel_count = @kernel_cells[{context.name, consumer}] %>
<td class="<%= cell_class(context.name, consumer, kernel_count) %>"<%= if kernel_count do %> title="<%= h(kernel_count) %> shared-kernel reads"<% end %> data-cell="<%= h(context.name) %>→<%= h(consumer) %>" data-owner="<%= h(context.name) %>" data-consumer="<%= h(consumer) %>">
<%= for {rule, count} <- Enum.sort(counts) do %><span class="count <%= h(rule) %>" title="<%= h(rule) %>"><%= h(count) %></span><% end %>
<%= if kernel_count do %><span class="count kernel-count"><%= h(kernel_count) %></span><% end %>
</td>
<% end %>
</tr>
<% end %>
</table></div>
<%= if @empty_contexts != [] do %><p class="muted empty-contexts">Contexts without schemas or findings: <%= Enum.map_join(@empty_contexts, ", ", &label/1) %></p><% end %>

<h2>Entities</h2>
<%= for context <- @contexts do %>
<div class="panel <%= if context.kernel, do: "kernel" %>" data-context="<%= h(context.name) %>">
<h3><%= h(context.name) %><%= if context.kernel do %> <span class="muted">shared kernel</span><% end %></h3>
<p class="muted mono">deps: <%= Enum.map_join(context.deps, ", ", &h/1) %></p>
<%= for schema <- context.schemas do %>
<div class="schema">
<div><span class="mono"><%= h(schema.module) %></span> <span class="muted mono"><%= h(schema.table) %></span>
<%= if schema.module in context.exports do %><span class="chip exported">exported</span><% end %></div>
<table>
<tr><th>field</th><th>type</th><th>reads</th><th>writes</th><th>findings</th></tr>
<%= for field <- schema.fields do %>
<tr>
<td class="mono"><%= h(field.name) %><%= if field.values do %><br><span class="muted"><%= Enum.map_join(field.values, " · ", &h/1) %></span><% end %></td>
<td class="mono muted type"><%= h(field.type) %></td>
<td class="mono"><%= counts(field.reads) %></td>
<td class="mono"><%= counts(field.writes) %></td>
<td><%= for finding <- Map.get(@findings_by_field, {schema.module, field.name}, []) do %><span class="chip <%= h(finding.rule) %>" title="<%= h(finding.key) %>"><%= h(finding.rule) %><%= if finding.value do %> <%= h(finding.value) %><% end %> ← <%= h(consumer_label(finding)) %></span><% end %></td>
</tr>
<% end %>
<%= for association <- schema.associations do %>
<tr><td class="mono"><%= h(association.name) %></td><td class="mono muted"><%= h(association.kind) %></td><td colspan="3" class="mono">→ <%= h(association.target) %><%= if association.foreign_key do %> <span class="muted">via <%= h(association.foreign_key) %></span><% end %></td></tr>
<% end %>
</table>
</div>
<% end %>
</div>
<% end %>

<section id="findings">
<h2>Findings <span class="muted">(<%= length(@document.findings) %> sites in <%= length(@concepts) %> concepts)</span></h2>
<div class="filters">
<%= for rule <- ["R1", "R3", "R4"] do %><label><input type="checkbox" data-filter-rule="<%= rule %>" checked> <%= rule %></label><% end %>
<label><input type="checkbox" data-filter="unverdicted"> unverdicted only</label>
<label><input type="checkbox" data-filter="anchored"> anchored only</label>
<label>owner <select data-filter="owner"><option value="">all</option><%= for owner <- @owners do %><option value="<%= h(owner) %>"><%= h(owner) %></option><% end %></select></label>
<label>consumer <select data-filter="consumer"><option value="">all</option><%= for consumer <- @finding_consumers do %><option value="<%= h(consumer) %>"><%= h(consumer) %></option><% end %></select></label>
<span class="muted" data-pair></span>
</div>
<%= for concept <- @concepts do %>
<% first = concept.representative %>
<div class="concept" data-concept="<%= h(concept.key) %>">
<div class="concept-head"><span class="chip <%= h(first.rule) %>"><%= h(first.rule) %></span> <span class="mono"><%= h(first.schema) %>.<%= h(first.field) %><%= if first.value do %> = <%= h(first.value) %><% end %></span> <span class="muted">owned by <%= h(first.owner) %> · <%= plural(length(concept.consumers), "consumer") %> · <%= plural(concept.site_count, "site") %></span></div>
<%= for consumer <- concept.consumers do %>
<% representative = consumer.representative %>
<div class="consumer <%= if is_nil(representative.verdict), do: "unverdicted" %>" data-key="<%= h(consumer.key) %>">
<div><span class="mono"><%= h(consumer_heading(representative)) %></span> <%= if representative.consumer do %><span class="muted">in <%= h(consumer_column(representative)) %></span><% end %><%= if representative.surfaces != [] do %><span class="muted"> · surfaces: <span class="mono"><%= Enum.map_join(representative.surfaces, ", ", &h/1) %></span></span><% end %></div>
<div class="mono muted key"><%= h(consumer.key) %></div>
<%= if representative.verdict do %><div><strong><%= h(representative.verdict) %></strong> — <%= h(representative.reason) %></div><% end %>
<%= for finding <- consumer.sites do %>
<div class="finding" data-rule="<%= h(finding.rule) %>" data-verdict="<%= h(finding.verdict || "") %>" data-anchored="<%= h(finding.anchored) %>" data-owner="<%= h(finding.owner) %>" data-consumer="<%= h(consumer_column(finding)) %>">
<div class="muted mono site"><%= h(finding.file) %>:<%= h(finding.line) %><%= unless finding.anchored do %> · candidate<% end %></div>
<pre class="excerpt"><%= h(finding.excerpt) %></pre>
</div>
<% end %>
</div>
<% end %>
</div>
<% end %>
</section>

<h2>Kernel reads <span class="muted">(<%= length(@document.kernel_reads) %>)</span></h2>
<table><tr><th>schema</th><th>field</th><th>target</th></tr>
<%= for read <- @document.kernel_reads do %><tr><td class="mono"><%= h(read.schema) %></td><td class="mono"><%= h(read.field) %></td><td class="mono"><%= h(read.target) %></td></tr><% end %>
</table>

<script>
{
  let pair = null;
  const filter = name => document.querySelector(`[data-filter="${name}"]`);
  const apply = () => {
    const rules = new Set([...document.querySelectorAll('[data-filter-rule]:checked')].map(b => b.dataset.filterRule));
    const onlyUnverdicted = filter('unverdicted').checked;
    const onlyAnchored = filter('anchored').checked;
    const owner = filter('owner').value;
    const consumer = filter('consumer').value;
    document.querySelectorAll('.finding').forEach(el => {
      const show = rules.has(el.dataset.rule)
        && (!onlyUnverdicted || el.dataset.verdict === '')
        && (!onlyAnchored || el.dataset.anchored === 'true')
        && (owner === '' || el.dataset.owner === owner)
        && (consumer === '' || el.dataset.consumer === consumer)
        && (pair === null || (el.dataset.owner === pair.owner && el.dataset.consumer === pair.consumer));
      el.classList.toggle('hidden', !show);
    });
    document.querySelectorAll('.consumer').forEach(el => el.classList.toggle('hidden', !el.querySelector('.finding:not(.hidden)')));
    document.querySelectorAll('.concept').forEach(el => el.classList.toggle('hidden', !el.querySelector('.consumer:not(.hidden)')));
    document.querySelectorAll('.matrix td.active').forEach(td => td.classList.remove('active'));
    const status = document.querySelector('[data-pair]');
    if (pair) {
      pair.cell.classList.add('active');
      status.textContent = `cell: ${pair.owner} → ${pair.consumer} (click it again to clear)`;
    } else {
      status.textContent = '';
    }
  };
  document.querySelectorAll('.filters input, .filters select').forEach(input => input.addEventListener('change', apply));
  document.querySelectorAll('.matrix td[data-cell]').forEach(cell => cell.addEventListener('click', () => {
    if (pair && pair.cell === cell) {
      pair = null;
    } else {
      pair = {cell, owner: cell.dataset.owner, consumer: cell.dataset.consumer};
      filter('owner').value = '';
      filter('consumer').value = '';
      document.getElementById('findings').scrollIntoView({behavior: 'smooth'});
    }
    apply();
  }));
}
</script>
</body>
</html>
