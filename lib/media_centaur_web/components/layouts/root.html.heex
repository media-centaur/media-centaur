<!DOCTYPE html>
<html lang="en" data-input="mouse" style={"--ui-scale: #{MediaCentaur.UIScale.cached_scale()}"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="MediaCentaur" suffix=" · Media Centaur">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        // Sidebar collapsed state
        const sidebarState = localStorage.getItem("phx:sidebar-collapsed");
        if (sidebarState === "true") {
          document.documentElement.setAttribute("data-sidebar", "collapsed");
        }
        // Remember each page's full URL (with query string) for sidebar nav
        document.addEventListener("click", (e) => {
          const navLink = e.target.closest("[data-nav-item]");
          if (!navLink) return;
          // Save current page's URL before navigating away
          sessionStorage.setItem("nav:" + location.pathname, location.pathname + location.search);
          // Restore stored URL for links that opt in
          if (navLink.hasAttribute("data-nav-remember")) {
            const basePath = new URL(navLink.href, location.origin).pathname;
            const stored = sessionStorage.getItem("nav:" + basePath);
            if (stored) navLink.setAttribute("href", stored);
          }
        }, true);

        // UI scale — server-rendered onto <html> for first paint; updated live
        // (no reload) when the Settings picker pushes a new value. Lives on
        // documentElement, which LiveView never replaces, so it persists across
        // live navigation between pages.
        window.addEventListener("phx:ui-scale", (e) => {
          document.documentElement.style.setProperty("--ui-scale", e.detail.scale);
        });

        window.addEventListener("phx:toggle-sidebar", () => {
          const el = document.documentElement;
          const collapsed = el.getAttribute("data-sidebar") === "collapsed";
          if (collapsed) {
            el.removeAttribute("data-sidebar");
            localStorage.removeItem("phx:sidebar-collapsed");
          } else {
            el.setAttribute("data-sidebar", "collapsed");
            localStorage.setItem("phx:sidebar-collapsed", "true");
          }
        });
      })();
    </script>
  </head>
  <body class="media-centaur">
    {@inner_content}

    <%!-- Gamepad hint bar — outside LiveView so it persists across navigations.
          Pure CSS visibility: driven by data-input and data-nav-context on <html>. --%>
    <div class="gamepad-hint-bar" aria-hidden="true">
      <div class="hint-group" data-hint-context="grid">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="y"></span> Clear Filter</span>
        <span class="hint"><span class="hint-btn" data-btn="start"></span> Play</span>
        <span class="hint"><span class="hint-btn" data-btn="lb-rb"></span> Zone</span>
      </div>
      <div class="hint-group" data-hint-context="modal">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Close</span>
        <span class="hint"><span class="hint-btn" data-btn="start"></span> Play</span>
      </div>
      <div class="hint-group" data-hint-context="drawer">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Close</span>
      </div>
      <div class="hint-group" data-hint-context="sidebar">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Back</span>
      </div>
      <div class="hint-group" data-hint-context="menu">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
      </div>
      <div class="hint-group" data-hint-context="shelf">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="start"></span> Play</span>
      </div>
    </div>

    <%!-- Work-in-progress nav notice — flashed briefly when a key/gamepad nav
          action fires on a page whose in-page navigation is still being built
          (driven by assets/js/input/wip_notice.js). Sits just above the gamepad
          hint bar; toggled by class (not data-input) so it surfaces for
          keyboard users too. --%>
    <div class="wip-notice" data-wip-notice aria-hidden="true">
      UI overhaul in progress, key nav is being added to this page.
    </div>
  </body>
</html>
