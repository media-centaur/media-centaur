<!DOCTYPE html>
<html
  lang="en"
  data-input="keyboard"
  style={"--ui-scale-pref: #{MediaCentaur.Settings.Preferences.UIScale.cached_scale()}"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="MediaCentaur" suffix=" · Media Centaur">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="icon" href={~p"/images/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- First-screen artwork warmup: lowest-priority browser prefetch at
          launch so the first visit to a poster-heavy page decodes from
          cache instead of blocking paint on fetch (ADR-012 sync decode;
          campaigns/instant-navigation.md Phase 4). Rendered once — the
          root layout survives live navigation. --%>
    <link
      :for={url <- MediaCentaurWeb.ArtworkWarmup.urls()}
      rel="prefetch"
      as="image"
      href={url}
    />
    <script>
      (() => {
        // Auto UI scale — the design is composed at 1920 CSS px wide. Scale
        // the shell so every screen shows that composition regardless of
        // resolution: screen.width is CSS px, so OS display scaling is
        // already accounted for. Floored at 0.7 so small laptops render a
        // readable miniature rather than a broken one. The Settings stepper
        // multiplies on top (--ui-scale-pref, server-rendered on <html>);
        // browser zoom composes on top of both. Runs synchronously in <head>
        // so the first paint is already scaled; recomputed when the window
        // lands on a different screen (resize fires on maximize/fullscreen
        // there, and Screen's own change event covers the rest).
        const applyAutoScale = () => {
          const auto = Math.max(0.7, screen.width / 1920);
          document.documentElement.style.setProperty(
            "--auto-scale",
            String(Math.round(auto * 10000) / 10000)
          );
        };
        applyAutoScale();
        window.addEventListener("resize", applyAutoScale);
        screen.addEventListener?.("change", applyAutoScale);

        // Sidebar collapsed state
        const sidebarState = localStorage.getItem("phx:sidebar-collapsed");
        if (sidebarState === "true") {
          document.documentElement.setAttribute("data-sidebar", "collapsed");
        }
        // Remember each page's full URL (with query string) for sidebar nav
        document.addEventListener("click", (e) => {
          const navLink = e.target.closest("[data-nav-item]");
          if (!navLink) return;
          // Save current page's URL before navigating away — minus any
          // params the page declares transient via
          // data-nav-transient-params (open modals/overlays, one-shot
          // triggers). Leaving a section closes its modals; the
          // remembered URL must not reopen them on return.
          const url = new URL(location.href);
          const transient = document.querySelector("[data-nav-transient-params]")
            ?.dataset.navTransientParams;
          if (transient) {
            transient.split(",").forEach((p) => url.searchParams.delete(p.trim()));
          }
          const query = url.searchParams.toString();
          sessionStorage.setItem(
            "nav:" + location.pathname,
            url.pathname + (query ? "?" + query : "")
          );
          // Restore stored URL for links that opt in
          if (navLink.hasAttribute("data-nav-remember")) {
            const basePath = new URL(navLink.href, location.origin).pathname;
            const stored = sessionStorage.getItem("nav:" + basePath);
            if (stored) navLink.setAttribute("href", stored);
          }
        }, true);

        // UI scale preference — server-rendered onto <html> for first paint;
        // updated live (no reload) when the Settings picker pushes a new
        // value. Lives on documentElement, which LiveView never replaces, so
        // it persists across live navigation between pages. The effective
        // --ui-scale is composed in CSS: auto × preference.
        window.addEventListener("phx:ui-scale", (e) => {
          document.documentElement.style.setProperty("--ui-scale-pref", e.detail.scale);
        });

        // Sidebar flyout hover state, projected onto <html> (data-sidebar-hover)
        // instead of relying on .sidebar:hover — live navigation replaces the
        // rail element, and pseudo-state on the new node lags a frame (visible
        // collapse+reopen). The attribute survives navigation, so the open rail
        // stays open across page switches. Delegated: survives DOM replacement.
        document.addEventListener("mouseover", (e) => {
          const inSidebar = !!e.target.closest?.("#sidebar");
          document.documentElement.toggleAttribute("data-sidebar-hover", inSidebar);
        });
        document.documentElement.addEventListener("mouseleave", () => {
          document.documentElement.removeAttribute("data-sidebar-hover");
        });

        window.addEventListener("phx:toggle-sidebar", () => {
          const el = document.documentElement;
          const collapsed = el.getAttribute("data-sidebar") === "collapsed";
          if (collapsed) {
            el.removeAttribute("data-sidebar");
            localStorage.removeItem("phx:sidebar-collapsed");
          } else {
            el.setAttribute("data-sidebar", "collapsed");
            localStorage.setItem("phx:sidebar-collapsed", "true");
          }
        });
      })();
    </script>
  </head>
  <body class="media-centaur">
    {@inner_content}

    <%!-- Gamepad hint bar — outside LiveView so it persists across navigations.
          Pure CSS visibility: driven by data-input and data-nav-context on <html>. --%>
    <div class="gamepad-hint-bar" aria-hidden="true">
      <div class="hint-group" data-hint-context="grid">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Menu</span>
        <span class="hint"><span class="hint-btn" data-btn="y"></span> Clear Filter</span>
        <span class="hint"><span class="hint-btn" data-btn="start"></span> Play</span>
        <span class="hint"><span class="hint-btn" data-btn="lb-rb"></span> Zone</span>
      </div>
      <div class="hint-group" data-hint-context="modal">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Close</span>
        <span class="hint"><span class="hint-btn" data-btn="start"></span> Play</span>
      </div>
      <div class="hint-group" data-hint-context="drawer">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Close</span>
      </div>
      <div class="hint-group" data-hint-context="sidebar">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Back</span>
      </div>
      <div class="hint-group" data-hint-context="menu">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Menu</span>
      </div>
      <div class="hint-group" data-hint-context="shelf">
        <span class="hint"><span class="hint-btn" data-btn="dpad"></span> Navigate</span>
        <span class="hint"><span class="hint-btn" data-btn="a"></span> Select</span>
        <span class="hint"><span class="hint-btn" data-btn="b"></span> Menu</span>
        <span class="hint"><span class="hint-btn" data-btn="start"></span> Play</span>
      </div>
    </div>

    <%!-- Work-in-progress nav notice — flashed briefly when a key/gamepad nav
          action fires on a page whose in-page navigation is still being built
          (driven by assets/js/input/wip_notice.js). Sits just above the gamepad
          hint bar; toggled by class (not data-input) so it surfaces for
          keyboard users too. --%>
    <div class="wip-notice" data-wip-notice aria-hidden="true">
      UI overhaul in progress, key nav is being added to this page.
    </div>
  </body>
</html>
