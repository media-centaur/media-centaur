#!/usr/bin/env python3
"""Round 11 — backdrop and logo instead of poster and backdrop.

Takes G's state 1 as make-round-10 does, then rewrites every band: the
poster comes out, a .logo slot goes in (a wordmark stand-in for the title,
built from the band's own title text, or nothing for a title without
artwork) and a .foot for the title card's corner gradient. Writes one page
per direction (R1..R4) on Q6's page (round10.css: the dark ground, the
flush columns, the hairline), Q-logo-switchboard/index.html with every knob
of both rounds live, and Q-logo-switchboard/compare.html with Q6 beside
the four at half size. Re-run after editing round11.css or a preset.
"""
import os, re, html as H

HERE = os.path.dirname(os.path.abspath(__file__))
os.chdir(HERE)

src = open('G-couch-feed/index.html', encoding='utf-8').read()
style = src[src.index('<style>') + len('<style>'):src.index('</style>')]
svg_i = src.index('<svg width="0"'); svg_j = src.index('</svg>', svg_i) + len('</svg>')
defs = src[svg_i:svg_j]
s1 = src[src.index('<section id="s1">'):]; s1 = s1[:s1.index('</section>')]
pw = s1[s1.index('<div class="pw">'):]

def div_end(text, start):
    depth = 0
    for m in re.finditer(r'<div\b|</div>', text[start:]):
        depth += 1 if m.group(0) == '<div' else -1
        if depth == 0:
            return start + m.end()
    raise ValueError('unbalanced div')

# titles that fall back to the typed title under data-mix="some"
OPT = {'charade', 'pioneer-one', 'spring', 'cosmos-laundromat'}
# two-line wordmarks: the break after this many words
TWO_LINE = {'big-buck-bunny': 2, 'night-of-the-living-dead': 3, 'tears-of-steel': 2, 'cosmos-laundromat': 1,
            'carnival-of-souls': 1, 'sprite-fright': 1, 'one-step-beyond': 2}

def wordmark(slug, title):
    words = title.split(' ')
    if slug in TWO_LINE and len(words) > 1:
        k = TWO_LINE[slug]
        lines = [' '.join(words[:k]), ' '.join(words[k:])]
        n = max(len(l) for l in lines)
        return f'<span class="wm two wm-{slug}" style="--n:{n}">{H.escape(lines[0])}<br>{H.escape(lines[1])}</span>'
    return f'<span class="wm wm-{slug}" style="--n:{len(title)}">{H.escape(title)}</span>'

def rewrite_band(band):
    # the poster goes
    band = re.sub(r'<img class="poster"[^>]*>', '', band)
    band = re.sub(r'<div class="poster poster-empty"[^>]*></div>', '', band)
    m = re.search(r'art/([a-z0-9-]+)-backdrop', band)
    t = re.search(r'<div class="l2"><b>([^<]*)</b>(?:<span class="y">([^<]*)</span>)?', band)
    title = t.group(1) if t else ''
    year = t.group(2) if t and t.group(2) else ''
    if m:
        slug = m.group(1)
        band = band.replace('class="entry band', 'class="entry band haslogo', 1)
        if slug in OPT:
            band = band.replace('<div class="entry', '<div data-logo-tier="opt" class="entry', 1)
        logo = f'<div class="logo">{wordmark(slug, title)}' + (f'<span class="yr">{year}</span>' if year else '') + '</div>'
    else:
        logo = ''
    # the logo and the foot are children of the entry, after .scrim, so the modes can place them
    band = band.replace('<div class="scrim"></div>', '<div class="scrim"></div><div class="foot"></div>' + logo, 1)
    return band

def rewrite_all(text):
    out, pos = [], 0
    while True:
        i = text.find('<div class="entry band', pos)
        if i < 0:
            out.append(text[pos:]); break
        j = div_end(text, i)
        out.append(text[pos:i]); out.append(rewrite_band(text[i:j])); pos = j
    return ''.join(out)

pw = rewrite_all(pw)

def first_n(text, opener, n):
    out, pos = [], 0
    for _ in range(n):
        i = text.index(opener, pos); j = div_end(text, i)
        out.append(text[i:j]); pos = j
    return out

def add_class(div, cls):
    return re.sub(r'class="entry', f'class="{cls} entry', div, 1) if 'class="entry' in div else div.replace('class="', f'class="{cls} ', 1)

# the first three bands in document order, whatever their attributes
starts = sorted(m.start() for m in re.finditer(r'<div (?:data-logo-tier="opt" )?class="entry band', pw))[:3]
bands = [pw[s:div_end(pw, s)] for s in starts]
cards = first_n(pw, '<div class="card', 2)
second = ('<div class="pw r10-second" id="cursor"><div class="r10-label"><span class="sec">Under the cursor</span>'
          '<span class="keys">the first band with the TV’s cursor, the second hovered; a rail card under the cursor.</span></div>'
          '<div class="page"><div class="col"><div class="feed">' + add_class(bands[0], 'cursor') + add_class(bands[1], 'hovered') + bands[2] +
          '</div></div><aside class="rail"><div class="people">' + add_class(cards[0], 'cursor') + cards[1] + '</div></aside></div></div>')

BASE = dict(ground='dark', unit='ink', tone='13', edges='sheet', hair='on', dissolve='240')
KNOBS10 = ['ground', 'unit', 'tone', 'edges', 'hair', 'still', 'dissolve']
KNOBS11 = ['logo', 'logo-h', 'place', 'mix']
KNOBS = KNOBS10 + KNOBS11

PRESETS = [
 dict(dir='R1-backdrop-only', title='R1 · Backdrop only',
      attrs=dict(BASE, still='wide', logo='none', **{'logo-h': '72'}, place='seam', mix='some'),
      keys='the subtraction: the poster gone, the typed title kept · the words start at the tile’s right and gain 118px of measure · the still wide · the band stays 224',
      legend='<b>R1 · Backdrop only.</b> The poster comes out and nothing goes in: the words start at the tile’s right, the typed title stays line 2, the still is the wide box. One picture per band instead of two, and the band’s height is unchanged. This is also what every logo direction falls back to for a title without a logo, so it is the column’s floor.'),
 dict(dir='R2-logo-headline', title='R2 · Logo headline',
      attrs=dict(BASE, still='wide', logo='headline', **{'logo-h': '72'}, place='seam', mix='some'),
      keys='the logo is line 2, on the ink, between who-did-what and the review; the year at its foot · the band grows to 264 for a 72px logo · a title without a logo sets its name in the same slot',
      legend='<b>R2 · Logo headline.</b> The title in its own lettering where the typed title was: line 1 says who did what, the logo says which title, the review follows. The logo box is 72px tall and the band grows by that (264), so a two-line review and the seat still fit. A title without a logo sets its name at 28px in the same slot, bottom-aligned, so the column’s rhythm holds across the mix. The still stays boxed at the right, wide.'),
 dict(dir='R3-title-card', title='R3 · Title card',
      attrs=dict(BASE, still='wide', logo='card', **{'logo-h': '72'}, place='corner', mix='some'),
      keys='the words keep the ink and lose the title line, so the review gets three lines · the logo sits on the picture, bottom right over a foot gradient, the year under it · the band stays 224 · the seam placement is on the switchboard, and it covers faces',
      legend='<b>R3 · Title card.</b> The picture carries the title. The words on the ink are who did what and the review, which gains a third line; the logo sits at the picture\u2019s bottom right over a foot gradient, drop-shadowed, the year under it — the streaming-app title card. The band stays 224. The switchboard has the seam placement, at the picture\u2019s left edge on the dissolve; rendered, it lands on the subject\u2019s face on most stills, since the crop centres the subject.'),
 dict(dir='R4-hero-band', title='R4 · Hero band',
      attrs=dict(BASE, still='full', logo='hero', **{'logo-h': '72'}, place='seam', mix='some'),
      keys='the Home hero’s anatomy at band scale: the logo first, then who did what, then the review, over the full still under the left scrim · the band 264',
      legend='<b>R4 · Hero band.</b> The app’s one artwork idiom carried into the Feed: the full still under a scrim heavy at the left, the logo first, the words under it. The band is 264. Twenty of these read as twenty small heroes; a title without a logo sets its name where the logo would be.'),
]

def attrs_str(a):
    return ' '.join(f'data-{k}="{v}"' for k, v in a.items())

def page(title, attrs, keys, legend, extra_head='', extra_body=''):
    label = f'<div class="r10-label"><span class="sec">{H.escape(title)}</span><span class="keys">{keys}</span></div>'
    return (f'<!doctype html><html lang="en" {attrs_str(attrs)}><head><meta charset="utf-8"><link rel="stylesheet" href="../base.css">'
            f'<title>{H.escape(title)}</title><style>{style}</style><link rel="stylesheet" href="../round10.css"><link rel="stylesheet" href="../round11.css">{extra_head}</head>'
            f'<body><div class="frame"><aside class="sidebar"><i></i><i></i><i class="on"></i><i></i><i></i><i class="gap"></i><i></i></aside>'
            f'<main><div class="content"><h1>Discovery</h1>{defs}{label}{pw}{second}'
            f'<p class="r10-legend">{legend}</p></div></main></div>{extra_body}</body></html>')

for p in PRESETS:
    os.makedirs(p['dir'], exist_ok=True)
    open(f"{p['dir']}/index.html", 'w', encoding='utf-8').write(page(p['title'], p['attrs'], p['keys'], p['legend']))

# --- the switchboard: both rounds' knobs ---
OPTIONS = {
 'logo':     [('none', 'none'), ('headline', 'headline'), ('card', 'card'), ('hero', 'hero')],
 'logo-h':   [('56', '56'), ('72', '72'), ('96', '96')],
 'place':    [('seam', 'seam'), ('corner', 'corner')],
 'mix':      [('some', 'some'), ('all', 'all'), ('none', 'none')],
 'still':    [('box', 'box'), ('wide', 'wide'), ('full', 'full')],
 'ground':   [('app', 'app'), ('dark', 'dark'), ('ink', 'ink')],
 'edges':    [('cards', 'cards'), ('sheet', 'sheet')],
 'hair':     [('on', 'on'), ('off', 'off')],
}
LABELS = {'logo': 'The logo', 'logo-h': 'Logo height', 'place': 'Card placement', 'mix': 'Titles with a logo',
          'still': 'The still', 'ground': 'Page ground', 'edges': 'Edges', 'hair': 'Hairline'}
NOTES = {'logo-h': 'headline · hero grow the band', 'place': 'card only', 'mix': 'some = four typed', 'still': '536 · 836 · 1236',
         'ground': 'round 10', 'edges': 'round 10', 'hair': 'round 10'}
SHOWN = ['logo', 'logo-h', 'place', 'mix', 'still', 'ground', 'edges', 'hair']

panel_css = open('Q-switchboard/index.html', encoding='utf-8').read()
panel_css = panel_css[panel_css.index('.sb{'):panel_css.index('</style>', panel_css.index('.sb{'))]

rows = ''
for k in SHOWN:
    note = f'<small>{NOTES[k]}</small>' if k in NOTES else ''
    btns = ''.join(f'<button data-k="{k}" data-v="{v}">{H.escape(t)}</button>' for v, t in OPTIONS[k])
    rows += f'<div class="row" data-row="{k}"><label>{LABELS[k]}{note}</label><span class="opts">{btns}</span></div>'
def js_obj(a):
    return '{' + ','.join(f'"{k}":"{v}"' for k, v in a.items()) + '}'
presets_js = '{' + ','.join(f'"{p["title"].split(" ")[0]}":{js_obj(p["attrs"])}' for p in PRESETS) + '}'
preset_btns = ''.join(f'<button data-preset="{p["title"].split(" ")[0]}" title="{H.escape(p["keys"])}">{H.escape(p["title"])}</button>' for p in PRESETS)

panel_html = f"""
<div class="sb" id="sb"><h2>Round 11 · knobs <button id="sb-hide">hide</button></h2>{rows}
<div class="presets">{preset_btns}</div>
<p class="foot">The state is in the address. <a href="compare.html">Q6 and the four side by side</a> · <a href="../Q-switchboard/index.html">round 10’s switchboard</a>.</p></div>
<button class="sb-show" id="sb-show">knobs</button>
<script>
const PRESETS={presets_js};
const KNOBS={KNOBS!r};
const DEFAULT=PRESETS.R2;
const root=document.documentElement;
function state(){{const s={{}};for(const k of KNOBS)s[k]=root.dataset[k.replace(/-(\\w)/g,(m,c)=>c.toUpperCase())];return s}}
function setAttr(k,v){{root.setAttribute('data-'+k,v)}}
function apply(s){{for(const k of KNOBS)setAttr(k,s[k]);paint()}}
function paint(){{
  const s=state();
  document.querySelectorAll('.sb .opts button').forEach(b=>b.classList.toggle('on',s[b.dataset.k]===b.dataset.v));
  document.querySelector('[data-row=place]').classList.toggle('off',s.logo!=='card');
  document.querySelector('[data-row="logo-h"]').classList.toggle('off',s.logo==='none');
  document.querySelector('[data-row=mix]').classList.toggle('off',s.logo==='none');
  document.querySelector('[data-row=hair]').classList.toggle('off',s.edges!=='sheet'&&s.unit!=='glass');
  document.querySelectorAll('.sb .presets button').forEach(b=>{{const p=PRESETS[b.dataset.preset];b.classList.toggle('on',KNOBS.every(k=>p[k]===s[k]))}});
  const keep=location.hash.includes('panel=off')?'&panel=off':'';
  history.replaceState(null,'',location.pathname+location.search+'#'+KNOBS.map(k=>k+'='+s[k]).join('&')+keep);
}}
function fromHash(){{
  const s=Object.assign({{}},DEFAULT);
  for(const kv of location.hash.replace(/^#/,'').split('&')){{const [k,v]=kv.split('=');if(KNOBS.includes(k)&&v)s[k]=v;if(k==='panel'&&v==='off')document.body.classList.add('sb-off')}}
  return s;
}}
document.querySelectorAll('.sb .opts button').forEach(b=>b.onclick=()=>{{setAttr(b.dataset.k,b.dataset.v);paint()}});
document.querySelectorAll('.sb .presets button').forEach(b=>b.onclick=()=>apply(PRESETS[b.dataset.preset]));
document.getElementById('sb-hide').onclick=()=>document.body.classList.add('sb-hidden');
document.getElementById('sb-show').onclick=()=>document.body.classList.remove('sb-hidden');
window.addEventListener('hashchange',()=>apply(fromHash()));
apply(fromHash());
</script>"""

os.makedirs('Q-logo-switchboard', exist_ok=True)
open('Q-logo-switchboard/index.html', 'w', encoding='utf-8').write(page(
    'Q · Logo switchboard', PRESETS[1]['attrs'],
    'backdrop and logo instead of poster and backdrop, every knob of rounds 10 and 11 live; the presets R1–R4 are the direction pages',
    '<b>Q · Logo switchboard.</b> The four logo directions and round 10’s knobs on one page. The wordmarks are stand-ins for the titles’ logo PNGs.',
    extra_head=f'<style>{panel_css}</style>', extra_body=panel_html))

q6 = '../Q6-dark-sheet-wide-still/index.html'
frames = (f'<figure class="today"><figcaption><b>Q6</b> <span>round 10’s recommendation, with the poster: the reference</span> <a href="{q6}">open</a></figcaption>'
          f'<div class="vp"><iframe src="{q6}" loading="eager"></iframe></div></figure>')
frames += ''.join(
    f'<figure><figcaption><b>{H.escape(p["title"])}</b> <span>{p["keys"]}</span> <a href="../{p["dir"]}/index.html">open</a></figcaption>'
    f'<div class="vp"><iframe src="../{p["dir"]}/index.html" loading="eager"></iframe></div></figure>' for p in PRESETS)
compare = f"""<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Round 11 · backdrop and logo</title><link rel="stylesheet" href="../base.css"><style>
body{{background:oklch(11% 0.015 264);padding:28px 24px 60px}}
h1{{font-size:22px;margin:0 0 6px}}p.lede{{margin:0 0 24px;max-width:110ch;font-size:15px;line-height:1.5;color:oklch(93% 0.01 264/.7)}}
.grid{{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 24px}}
figure{{margin:0;min-width:0}}figure.today .vp{{outline:1px dashed oklch(93% 0.01 264/.25);outline-offset:4px}}figcaption{{font-size:14px;line-height:1.4;margin:0 0 8px;color:oklch(93% 0.01 264/.72)}}
figcaption b{{color:var(--bc);font-size:16px;margin-right:8px}}figcaption a{{color:var(--p);margin-left:8px}}
.vp{{position:relative;width:100%;aspect-ratio:1920/1080;overflow:hidden;border-radius:8px;box-shadow:0 8px 30px oklch(0% 0 0/.5);background:#000}}
.vp iframe{{position:absolute;left:0;top:0;width:1920px;height:1080px;border:0;transform-origin:0 0;transform:scale(var(--k));pointer-events:none}}
</style></head><body><h1>Round 11 · backdrop and logo instead of poster and backdrop</h1>
<p class="lede">Q6 with the poster, then the four logo directions on Q6’s page, at half size. The wordmarks stand in for the titles’ logo PNGs; four titles are drawn without one so every direction shows its fallback. Open one for the 1920 render; the <a href="index.html" style="color:var(--p)">switchboard</a> flips every knob of both rounds.</p>
<div class="grid">{frames}</div>
<script>function fit(){{document.querySelectorAll('.vp').forEach(v=>v.style.setProperty('--k',(v.clientWidth/1920).toFixed(4)))}}fit();addEventListener('resize',fit)</script>
</body></html>"""
open('Q-logo-switchboard/compare.html', 'w', encoding='utf-8').write(compare)
print('built:', ', '.join(p['dir'] for p in PRESETS), 'Q-logo-switchboard/{index,compare}.html')
