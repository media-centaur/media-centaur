#!/usr/bin/env bash
# Regenerate the round-4 mockup artwork from the showcase's PD/CC library.
# Output is git-ignored (art/); run from anywhere. Needs `vips`.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
src="$here/../../../../priv/showcase/images"
out="$here/art"
mkdir -p "$out"
# slug  image-dir-uuid
while read -r slug uuid; do
  [ -z "$slug" ] && continue
  vips thumbnail "$src/$uuid/poster.jpg" "$out/$slug-poster.jpg[Q=84,strip]" 400 --height 600 >/dev/null
  vips thumbnail "$src/$uuid/backdrop.jpg" "$out/$slug-backdrop.jpg[Q=80,strip]" 1600 >/dev/null
  echo "$slug"
done <<'LIST'
