#!/usr/bin/env bash
# Wipe and re-seed the showcase database from scratch.
#
# Flow:
#   1. Stop any showcase server listening on :4003 (best-effort).
#   2. Delete priv/showcase/media-centaur.db{,-shm,-wal}.
#   3. ecto.create + ecto.migrate against the showcase override TOML.
#   4. mix seed.showcase (populates ~14 movies, 2 TV series, stubs for
#      content files so the detail modals don't show "missing" banners).
#      TMDB answers come from the committed recording in
#      priv/showcase/tmdb/; no key is needed. Artwork comes from TMDB's
#      public image CDN.
#
#   scripts/reseed-showcase            reseed from the recording
#   scripts/reseed-showcase --record   first record what the recording
#                                      lacks (a seed with --record-tmdb and a
#                                      real key: TMDB_API_KEY, else the dev
#                                      DB's stored key, never printed), then
#                                      reseed from the recording
#
# All generated state lives inside priv/showcase/ — removing the database,
# media and images there is a full reset and this script rebuilds it.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Showcase config override + isolated build root (see scripts/showcase-env).
. "$REPO_ROOT/scripts/showcase-env"
SHOWCASE_DB="priv/showcase/media-centaur.db"
SHOWCASE_PORT=4003

# 1. Stop any showcase-on-4003 so the DB isn't locked when we wipe.
# `|| true` on the pipeline — under `set -eo pipefail` a grep miss (no
# server running, which is the common case) would silently kill the
# script here otherwise.
pid=$(ss -tlnpH 2>/dev/null | awk -v p=":$SHOWCASE_PORT" '$4 ~ p {print $0}' | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true)
if [ -n "$pid" ]; then
  echo "stopping showcase server pid=$pid"
  kill "$pid" 2>/dev/null || true
  for _ in 1 2 3 4 5 6 7 8; do
    sleep 1
    ss -tlnpH 2>/dev/null | grep -q ":$SHOWCASE_PORT" || break
  done
fi

RECORD=0
[ "${1:-}" = "--record" ] && RECORD=1

# 2–3. Wipe the DB + WAL sidecars, then create + migrate.
# MEDIA_CENTAUR_CONFIG_OVERRIDE (from showcase-env) points at the shipped
# showcase TOML, which carries an explicit priv/showcase/media-centaur.db
# path so there's no risk of hitting the default dev DB.
fresh_database() {
  rm -f "$SHOWCASE_DB" "${SHOWCASE_DB}-shm" "${SHOWCASE_DB}-wal"
  mise exec -- mix ecto.create
  mise exec -- mix ecto.migrate
}

# Recording reaches the live TMDB API, so it needs a real key: the
# caller's TMDB_API_KEY, else the dev DB's stored one (read-only).
if [ "$RECORD" = 1 ]; then
  dev_db="$HOME/.local/share/media-centaur/media-centaur.db"
  if [ -z "${TMDB_API_KEY:-}" ] && [ -f "$dev_db" ]; then
    TMDB_API_KEY=$(sqlite3 "$dev_db" "SELECT json_extract(value, '\$.value') FROM settings_entries WHERE key = 'config:tmdb_api_key' LIMIT 1;" 2>/dev/null || true)
  fi
  if [ -z "${TMDB_API_KEY:-}" ]; then
    echo "error: --record needs a TMDB key: set TMDB_API_KEY, or save one in the dev app's Settings → TMDB." >&2
    exit 1
  fi
  fresh_database
  TMDB_API_KEY="$TMDB_API_KEY" mise exec -- mix seed.showcase --record-tmdb
fi

# 4. Seed from the recording. The variable is cleared so the seed cannot
# lean on a key: whatever it asks for must be recorded.
fresh_database
env -u TMDB_API_KEY mise exec -- mix seed.showcase
