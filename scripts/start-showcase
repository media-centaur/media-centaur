#!/usr/bin/env bash
# Start the showcase phx server (foreground) on :4003 with the right
# env: MEDIA_CENTAUR_CONFIG_OVERRIDE pointing at the shipped showcase
# TOML. No TMDB key: showcase mode answers the TMDB API from the
# recording in priv/showcase/tmdb/ (MediaCentaur.Showcase.Stubs).
#
# Run in a terminal you can leave open — this process stays in the
# foreground. For background-with-logs, see `scripts/reseed-showcase`
# which stops any existing server before it seeds.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Showcase config override + isolated build root (see scripts/showcase-env).
. "$REPO_ROOT/scripts/showcase-env"

exec mise exec -- mix phx.server
