    },
    "/plans/{id}/approve": {
      "post": {
        "operationId": "approvePlan",
        "tags": [
          "Plans"
        ],
        "summary": "Commit a ready plan",
        "description": "Starts a pursuit for every unit the plan found. The plan's `pursuit_id` is then set.",
        "responses": {
          "200": {
            "description": "The committed plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "404": {
            "description": "No such resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Not `ready` (`plan_not_ready`), or part of it is already downloading (`already_downloading`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The plan found nothing (`nothing_to_grab`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/plans/{id}/discard": {
      "post": {
        "operationId": "discardPlan",
        "tags": [
          "Plans"
        ],
        "summary": "Discard a plan",
        "description": "",
        "responses": {
          "200": {
            "description": "The discarded plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "404": {
            "description": "No such resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Already committed or discarded (`plan_not_ready`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/pursuits": {
      "get": {
        "operationId": "listPursuits",
        "tags": [
          "Pursuits"
        ],
        "summary": "List downloads Media Centaur is tracking",
        "description": "Newest-updated first.",
        "responses": {
          "200": {
            "description": "The pursuits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PursuitList"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is missing or invalid (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "failed",
                "cancelled",
                "succeeded",
                "terminal"
              ],
              "default": "active"
            },
            "description": "`terminal` is every pursuit that is over."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ]
      }
    },
    "/pursuits/{id}": {
      "get": {
        "operationId": "getPursuit",
        "tags": [
          "Pursuits"
        ],
        "summary": "Read one download's progress",
        "description": "`state` values `satisfied`, `partial`, `exhausted` and `cancelled` are final.",
        "responses": {
          "200": {
            "description": "The pursuit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PursuitDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/pursuits/{id}/search-again": {
      "post": {
        "operationId": "searchAgain",
        "tags": [
          "Pursuits"
        ],
        "summary": "Plan what did not land",
        "description": "Creates a new plan for the pursuit's units that gave up or were cancelled, skipping releases already tried. Only for pursuits started from a title.",
        "responses": {
          "202": {
            "description": "The new plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is missing or invalid (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Nothing left to retry (`nothing_to_plan`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchAgainRequest"
              }
            }
